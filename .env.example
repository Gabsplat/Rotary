# Postgres. En Vercel la carga sola la integración de Neon.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Auth.js. Generar el secreto con: openssl rand -base64 33
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Correos que siempre pueden entrar al panel (separados por coma). Sirve para
# el primer ingreso; el resto de los socios se carga desde el panel.
ADMIN_EMAILS=

# Solo en desarrollo local: habilita ingresar al panel escribiendo un correo,
# sin pasar por Google. No tiene efecto en producción.
AUTH_DEV_LOGIN=
